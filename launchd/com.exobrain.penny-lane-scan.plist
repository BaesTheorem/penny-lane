<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.exobrain.penny-lane-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alexhedtke/Documents/penny-lane/bin/penny</string>
    <string>all</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/alexhedtke/Documents/penny-lane</string>
  <!-- Community lists move on Tuesday mornings (DG) and daily ~10:00 UTC (HD);
       four pulls a day keep the join fresh without leaning on any lane. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>20</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/alexhedtke/Library/Logs/exobrain/penny-lane-scan.log</string>
  <key>StandardErrorPath</key><string>/Users/alexhedtke/Library/Logs/exobrain/penny-lane-scan.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
